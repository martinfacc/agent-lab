# Carpetas del host. En Windows usá barras hacia adelante.
PROJECT_PATH=C:/Projects/my-bmad-project
OUTPUT_PATH=C:/Users/me/Documents/Agent Lab

# Identidad de los commits. El push sigue siendo manual en el piloto.
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Ejecución
TZ=America/Argentina/Buenos_Aires
HERMES_PORT=9119
MONITOR_PORT=9121
LAB_MODE=development
LAB_PROVIDER=copilot
# Dejalo vacío para usar la selección automática de Copilot.
# Para ejecuciones reproducibles, indicá un modelo habilitado en tu plan (ej.: gpt-5.4).
COPILOT_MODEL=
# Los subagentes heredan el modelo y esfuerzo de la sesión principal.
COPILOT_SUBAGENT_MODEL=inherit
COPILOT_SUBAGENT_EFFORT=inherit
COPILOT_SUBAGENT_CONTEXT=inherit
COPILOT_SUBAGENT_NAMES=explore,task,code-review,general-purpose,research,security-review,rubber-duck

# BMAD
# Si el repositorio ya contiene _bmad, se valida y esta configuración no lo pisa.
# Si no lo contiene, se usa la distribución incluida en la imagen.
# El equipo solo debe indicar dónde se encuentran los artefactos del proyecto.
BMAD_OUTPUT_DIR=_bmad-output
# Vacías: se derivan como planning-artifacts e implementation-artifacts dentro de BMAD_OUTPUT_DIR.
BMAD_PLANNING_ARTIFACTS_DIR=
BMAD_IMPLEMENTATION_ARTIFACTS_DIR=
BMAD_COMMUNICATION_LANGUAGE=spanish
BMAD_DOCUMENT_LANGUAGE=spanish
BMAD_PROJECT_NAME=
BMAD_USER_NAME=

# Notificaciones externas opcionales: telegram, ntfy o telegram,ntfy.
NOTIFY_CHANNELS=
NOTIFY_EVENTS=paused,awaiting-operator,crashed,finished
NOTIFY_PROJECT_NAME=Mi proyecto
NOTIFY_MONITOR_URL=http://localhost:9121

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Si queda vacío se autoriza solamente TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_CHAT_IDS=
# read-only permite consultas; controlled agrega acciones con confirmación.
TELEGRAM_COMMANDS=read-only

# ntfy
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
RESEARCH_PROVIDER=github-copilot
# Elegí un modelo competente habilitado en tu plan.
# Solo es necesario con LAB_MODE=full.
RESEARCH_MODEL=disabled
RESEARCH_TOKEN_BUDGET=30000

# Alternativa opcional con OpenCode
# OPENCODE_API_KEY=

#!/usr/bin/env bash
set -euo pipefail

if [ "$(id -u)" = "0" ]; then
  exec runuser --user agent --preserve-environment -- "$0" "$@"
fi

usage() {
  cat <<'EOF'
Uso: lab <comando>

  serve          Inicia el panel local de Hermes
  monitor        Inicia solamente el monitor web de desarrollo
  setup          Configura las funciones habilitadas por LAB_MODE
  setup-development Configura GitHub, Copilot y Hermes, sin Prime
  setup-full     Configura GitHub, Copilot, Prime y Hermes
  login-github   Inicia sesión en GitHub y configura el acceso Git privado
  login-copilot  Verifica GitHub Copilot CLI con la sesión de GitHub
  login-prime    Inicia sesión en Prime Agent
  setup-hermes   Configura el proveedor y modelo de Hermes
  doctor         Valida la instalación completa
  preflight      Confirma si el proyecto está listo para iniciar un desarrollo
  runs           Muestra runs interrumpidos que pueden recuperarse
  recover ID     Reanuda explícitamente un run interrumpido
  support-bundle Genera un ZIP de diagnóstico sanitizado
  healthcheck    Comprueba rápidamente la salud del contenedor
  shell          Abre una terminal dentro del proyecto montado
EOF
}

configure_mcp() {
  if hermes mcp list 2>/dev/null | grep -q 'agent-control'; then
    printf 'y\n' | hermes mcp remove agent-control >/dev/null 2>&1 || true
  fi
  printf 'y\n' | hermes mcp add agent-control \
    --command /opt/agent-control/node_modules/.bin/tsx \
    --env \
      AGENT_CONTROL_PROJECT_PATH=/workspace/project \
      AGENT_CONTROL_DATA_DIR=/workspace/output/control \
      AGENT_CONTROL_LOG_DIR=/workspace/output/development/logs \
      BMAD_SPRINT_STATUS_PATH="${BMAD_SPRINT_STATUS_PATH:?Ruta BMAD no resuelta}" \
      LAB_MODE="${LAB_MODE:-development}" \
      PRIME_WORKERS_DIR=/home/agent/.prime/agent/daemon-workers \
      RESEARCH_PROVIDER="${RESEARCH_PROVIDER:-github-copilot}" \
      RESEARCH_MODEL="${RESEARCH_MODEL:?Set RESEARCH_MODEL}" \
      RESEARCH_TOKEN_BUDGET="${RESEARCH_TOKEN_BUDGET:-30000}" \
    --args /opt/agent-control/src/index.ts
}

login_github() {
  if ! gh auth status >/dev/null 2>&1; then
    gh auth login --hostname github.com --git-protocol https --web
  fi
  gh auth setup-git
  gh auth status
  echo 'GitHub quedó autenticado y configurado para repositorios privados.'
}

login_copilot() {
  echo 'Verificando Copilot con la sesión ya iniciada en GitHub...'
  local response
  response="$(copilot -sp 'Respond exactly: COPILOT_OK')"
  if [[ "$response" != *COPILOT_OK* ]]; then
    echo "Copilot respondió de forma inesperada: $response" >&2
    return 1
  fi
  echo 'Copilot quedó disponible.'
}

login_prime() {
  echo 'Dentro de Prime ejecutá /login y elegí GitHub Copilot.'
  echo 'Anotá un modelo habilitado y salí con /exit para continuar.'
  prime-agent
}

setup_development() {
  echo '=== 1/3 GitHub y repositorio privado ==='
  login_github
  echo '=== 2/3 GitHub Copilot ==='
  login_copilot
  echo '=== 3/3 Hermes ==='
  hermes setup model
  configure_mcp
  echo 'Configuración de desarrollo terminada.'
}

setup_full() {
  if [ -z "${RESEARCH_MODEL:-}" ] || [ "${RESEARCH_MODEL}" = 'disabled' ]; then
    echo 'Definí RESEARCH_MODEL en .env antes de configurar el modo full.' >&2
    return 1
  fi
  echo '=== 1/4 GitHub y repositorio privado ==='
  login_github
  echo '=== 2/4 GitHub Copilot ==='
  login_copilot
  echo '=== 3/4 Prime Agent ==='
  login_prime
  echo '=== 4/4 Hermes ==='
  hermes setup model
  configure_mcp
  echo 'Configuración completa terminada.'
}

case "${1:-serve}" in
  serve)
    configure_mcp
    python3 /usr/local/lib/agent-lab/dashboard-proxy.py &
    python3 /usr/local/lib/agent-lab/monitor-server.py &
    python3 /usr/local/lib/agent-lab/notification-worker.py &
    exec hermes dashboard --host 127.0.0.1 --port 9120 --no-open
    ;;
  monitor)
    exec python3 /usr/local/lib/agent-lab/monitor-server.py
    ;;
  setup)
    if [ "${LAB_MODE:-development}" = 'full' ]; then
      setup_full
    else
      setup_development
    fi
    ;;
  setup-development)
    setup_development
    ;;
  setup-full)
    setup_full
    ;;
  login-github)
    login_github
    ;;
  login-copilot)
    login_copilot
    ;;
  login-prime)
    login_prime
    ;;
  setup-hermes)
    hermes setup model
    ;;
  doctor)
    /usr/local/lib/agent-lab/doctor
    ;;
  preflight)
    /usr/local/lib/agent-lab/preflight
    ;;
  runs)
    python3 /usr/local/lib/agent-lab/run-recovery.py scan --write
    ;;
  recover)
    if [ -z "${2:-}" ]; then
      echo 'Uso: lab recover <run-id>' >&2
      exit 2
    fi
    python3 /usr/local/lib/agent-lab/run-recovery.py recover "$2"
    ;;
  support-bundle)
    python3 /usr/local/lib/agent-lab/support-bundle.py
    ;;
  healthcheck)
    curl --fail --silent http://127.0.0.1:9119/ >/dev/null
    curl --fail --silent http://127.0.0.1:9121/api/snapshot >/dev/null
    ;;
  shell)
    cd /workspace/project
    exec bash
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
